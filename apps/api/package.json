{
  "name": "@ic/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@ic/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
