# ---------- Domain / URLs ----------
# Domain served by Caddy (production). Use "localhost" for a local docker run.
DOMAIN=ic-klima-service.de
# Public URL of the website (used for sitemap, OpenGraph, links in emails)
PUBLIC_SITE_URL=https://ic-klima-service.de
# URL the Next.js server uses to reach the API (docker: http://api:4000, local dev: http://localhost:4000)
API_INTERNAL_URL=http://localhost:4000

# ---------- Database ----------
POSTGRES_USER=ic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ic_klima
# Local dev: docker-compose.dev.yml exposes postgres on POSTGRES_PORT (change it if 5432 is taken)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ic:change-me@localhost:5432/ic_klima?schema=public

# ---------- API ----------
API_PORT=4000
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# true in production (HTTPS), false for local http
COOKIE_SECURE=false
UPLOAD_DIR=./uploads

# First admin user. Created automatically on API start if no admin exists.
ADMIN_EMAIL=admin@ic-klima-service.de
ADMIN_PASSWORD=change-me-please

# ---------- Mail (new lead notifications) ----------
# Leave SMTP_HOST empty to only log notifications to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IC Klima Service <no-reply@ic-klima-service.de>"
MAIL_TO=vertrieb@ic-klima-service.de
